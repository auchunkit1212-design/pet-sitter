# Stripe（Dashboard → Developers → API keys）
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# 前端網址（Stripe 成功／取消回跳）
# Netlify 例子：https://your-site.netlify.app
CLIENT_URL=http://localhost:5173

# API port（本機 node server）
PORT=8787

# 前端 base path（Netlify 用 /；GitHub Pages 用 /pet-sitter/）
VITE_BASE_PATH=/

# 前端呼叫 API（Netlify 同域可留空）
VITE_API_URL=
