{
  "name": "90s-pet-sitter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "concurrently -k \"npm:dev:api\" \"vite preview --host 0.0.0.0 --port 4173\"",
    "start:api": "tsx server/index.ts",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "concurrently": "^10.0.4",
    "hono": "^4.12.32",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
